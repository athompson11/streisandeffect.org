---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollections } from '../data/archive';

const collections = getCollections();
---
<BaseLayout
  title="Records should not vanish quietly"
  description="An independent pro-trans public-interest archive preserving withdrawn documents with provenance, source links, and verification data."
>
  <section class="hero">
    <p class="eyebrow">Independent public-interest archive</p>
    <h1>Records should not vanish quietly.</h1>
    <p class="lede">
      streisandeffect.org preserves withdrawn or hard-to-find documents when their publication, removal, or alteration matters to public debate. Each record separates document metadata, publisher statements, external responses, and archive interpretation.
    </p>
    <div class="actions">
      <a class="button" href="/collections/">Browse collections</a>
      <a class="button secondary" href="/verify/">Verify a download</a>
    </div>
  </section>

  <section class="section prose" aria-labelledby="how-it-works">
    <h2 id="how-it-works">How to read this archive</h2>
    <p>
      The archive has an explicit pro-trans editorial position. It does not treat opposition to trans rights as neutral, but factual claims still need evidence. Publisher statements, external criticism, and archive opinion are labelled so readers can tell what is known, what is disputed, and what the archive operator concludes.
    </p>
  </section>


  <section class="section" aria-labelledby="collections-heading">
    <h2 id="collections-heading">Collections</h2>
    <div class="document-list">
      {collections.map((collection) => (
        <article class="document-card">
          <header>
            <div>
              <h3><a href={`/${collection.slug}/`}>{collection.title}</a></h3>
              <p>{collection.summary}</p>
            </div>
            <span class="document-count">{collection.documents.length} documents</span>
          </header>
          <div class="status-grid" aria-label="Collection status">
            <div>
              <strong>Publisher status</strong>
              <p>{collection.publisherStatus}</p>
            </div>
            <div>
              <strong>Archive status</strong>
              <p>{collection.archiveStatus}</p>
            </div>
          </div>
          <p class="document-action"><a href={`/${collection.slug}/`}>Open collection →</a></p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
