---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollections } from '../../data/archive';

const collections = getCollections();
---
<BaseLayout title="Collections" description="Document collections preserved by streisandeffect.org.">
  <section class="prose">
    <p class="eyebrow">Collections</p>
    <h1>Preserved document collections</h1>
    <p class="lede">
      Collections group related documents with provenance, publisher status, source links, and archive notes.
    </p>
  </section>

  <section class="section document-list" aria-label="Available collections">
    {collections.map((collection) => (
      <article class="document-entry">
        <header>
          <div>
            <h2><a href={`/${collection.slug}/`}>{collection.title}</a></h2>
            <p>{collection.summary}</p>
          </div>
          <span class="document-count">{collection.documents.length} documents</span>
        </header>
        <dl class="status-list">
          <div>
            <dt>Publisher status</dt>
            <dd>{collection.publisherStatus}</dd>
          </div>
          <div>
            <dt>Archive status</dt>
            <dd>{collection.archiveStatus}</dd>
          </div>
          <div>
            <dt>Last metadata review</dt>
            <dd>{collection.lastReviewed}</dd>
          </div>
        </dl>
        <p class="document-action"><a href={`/${collection.slug}/`}>Open collection →</a></p>
      </article>
    ))}
  </section>
</BaseLayout>
