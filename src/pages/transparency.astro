---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Transparency" description="Request and correction transparency log for streisandeffect.org.">
  <section class="prose">
    <p class="eyebrow">Transparency</p>
    <h1>Requests, corrections, and changes</h1>
    <p class="lede">This page identifies whether the archive has published public entries about requests, corrections, or changes.</p>
    <p class="last-reviewed">Last updated: 2026-09-07</p>
  </section>

  <section class="section prose">
    <h2>Public entries</h2>
    <p>No public log entries are currently listed.</p>
  </section>

  <section class="section prose">
    <h2>Information a future public entry may include</h2>
    <p>Where publishing information is appropriate, an entry may include:</p>
    <ul class="kicker-list">
      <li>Date received.</li>
      <li>Request category.</li>
      <li>Material affected.</li>
      <li>Requested action.</li>
      <li>Archive response.</li>
      <li>Current status.</li>
      <li>Whether identifying details were withheld for privacy or safety.</li>
    </ul>
  </section>
</BaseLayout>
